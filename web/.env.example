# Copy this file to web/.env.local (gitignored) and fill in the two values from
# your Supabase dashboard → Project Settings.
#   VITE_SUPABASE_URL             = Project URL (Data API)   e.g. https://abcd1234.supabase.co
#   VITE_SUPABASE_PUBLISHABLE_KEY = publishable key (API Keys) — starts with sb_publishable_
# Both are safe to expose in the browser bundle; RLS guards the data. Never put
# the SECRET key (sb_secret_…) here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
